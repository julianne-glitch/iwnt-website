# Hostinger MCP API Token
# Replace YOUR_HOSTINGER_API_TOKEN with your API token generated from Hostinger hPanel -> Account Information -> API
HOSTINGER_API_TOKEN=YOUR_HOSTINGER_API_TOKEN
API_TOKEN=YOUR_HOSTINGER_API_TOKEN

# NextAuth (required for /admin)
AUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Postgres (required for Resources CMS articles, contact enquiries, admin)
# Without this, public marketing pages still load; /resources shows static CNPS content only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
